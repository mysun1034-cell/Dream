# .env.local 로 복사한 뒤 Supabase 대시보드 Project Settings 의 API 메뉴에서 값을 옮겨 적는다.
# 브라우저에 공개돼도 되는 값만 쓴다. secret 키(sb_secret_...)와 service_role 키는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# publishable 키가 없는 프로젝트라면 위 줄 대신 anon 키를 쓴다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
